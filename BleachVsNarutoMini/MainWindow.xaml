<Window x:Class="BleachVsNarutoMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bleach vs Naruto Mini" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Canvas chính làm màn chơi -->
        <Canvas x:Name="GameCanvas" Focusable="True">
            <Canvas.Background>
                <!-- Kéo ảnh arena1_bg.png từ thư mục Images vào làm hình nền -->
                <ImageBrush ImageSource="Assets/Images/arena1_bg.png" Stretch="Fill"/>
            </Canvas.Background>
        </Canvas>
    </Grid>
</Window>